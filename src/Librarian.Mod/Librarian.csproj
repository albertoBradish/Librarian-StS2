<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Version>1.3.5</Version>
        <AssemblyVersion>1.3.5.0</AssemblyVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <Publicize>False</Publicize> <!--Allows access to originally private/protected members but may (unlikely to) cause errors.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
        <RitsuLibReferenceTarget>$(LibrarianGameVersion)</RitsuLibReferenceTarget>
        <DefineConstants Condition="'$(LibrarianGameVersion)' == '0.111.0'">$(DefineConstants);LIBRARIAN_API_0111</DefineConstants>
        <DefineConstants Condition="'$(LibrarianGameVersion)' == '0.107.1'">$(DefineConstants);LIBRARIAN_API_0107</DefineConstants>
    </PropertyGroup>

    <Import Project="../../.research/tools/ritsulib/v0.6.4/RitsuLib.References.props" />

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Librarian.Core/*.cs" Link="SharedCore/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')" >
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="$(Publicize)">
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- Generates a .pck file when building if only using simple assets. May not work on all setups. Uncomment to test. -->
        <!-- <PackageReference Include="BSchneppe.StS2.PckPacker" Version="0.1.1" PrivateAssets="All" /> -->
        <AdditionalFiles Include="Librarian/localization/**/*.json"/> <!-- Used by analyzer -->
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Librarian/**" />
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <EmbeddedResource Remove="Librarian/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include=".gitignore" />
        <None Include="Librarian.json" />
        <None Include="project.godot"/>
        <None Include="Librarian/**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Librarian\images\card_portraits\big\" />
      <Folder Include="Librarian\images\powers\big\" />
      <Folder Include="Librarian\images\relics\big\" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths" >
        <Error Condition="'$(LibrarianGameVersion)' != '0.107.1' and '$(LibrarianGameVersion)' != '0.111.0'"
               Text="LibrarianGameVersion must be an explicitly supported API target: 0.107.1 or 0.111.0." />
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
               Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
        <Error Condition="$([System.IO.Path]::GetFullPath('$(Sts2DataDir)')) != $([System.IO.Path]::GetFullPath('$(Sts2Path)/data_sts2_windows_x86_64'))"
               Text="Librarian must reference the verified isolated installation for its selected API target." />
        <GetFileHash Files="$(Sts2DataDir)/sts2.dll" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="LibrarianGameAssemblyHash" />
        </GetFileHash>
        <Error Condition="'%(LibrarianGameAssemblyHash.FileHash)' != '$(LibrarianExpectedGameHash)'"
               Text="The referenced sts2.dll does not match the selected approved API target." />
    </Target>

    <!-- build_librarian.py owns packaging and isolated deployment. A content build
         must never replace the root bootstrap DLL or either historical runtime. -->
</Project>
