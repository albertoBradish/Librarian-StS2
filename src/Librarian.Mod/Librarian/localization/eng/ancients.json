{
  "THE_ARCHITECT.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.char": "I will keep reading this tower.",
  "THE_ARCHITECT.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.next": "Turn the page",
  "THE_ARCHITECT.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.ancient": "Then show me what you remember.",
  "THE_ARCHITECT.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.char": "Then let us begin with the page we forgot.",
  "THE_ARCHITECT.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-startattack": "None",
  "THE_ARCHITECT.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-endattack": "Both",
  "THE_ARCHITECT.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.next": "Respond",
  "THE_ARCHITECT.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.next": "Continue",
  "THE_ARCHITECT.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-attack": "Both",
  "NEOW.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.ancient": "...little library... back again...",
  "NEOW.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.next": "Respond",
  "NEOW.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.char": "The pages remain. More of them are blank.",
  "NEOW.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.next": "Continue",
  "NEOW.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.ancient": "...then... write another page...",
  "NEOW.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.next": "Continue",
  "DARV.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.ancient": "A walking bookshelf! See anything here you lost?",
  "DARV.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.next": "Respond",
  "DARV.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.char": "If you find loose pages, please do not use them to level a table.",
  "DARV.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.next": "Continue",
  "DARV.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.ancient": "Ha! Better pick something before I tidy up!",
  "DARV.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.next": "Continue",
  "NONUPEIPE.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.ancient": "Creature of books, let fortune turn your next page.",
  "NONUPEIPE.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.next": "Respond",
  "NONUPEIPE.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.char": "I usually read the contents first.",
  "NONUPEIPE.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.next": "Continue",
  "NONUPEIPE.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.ancient": "This time, even the contents are unwritten.",
  "NONUPEIPE.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.next": "Continue",
  "OROBAS.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.ancient": "Your pages need more color!!!",
  "OROBAS.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.next": "Respond",
  "OROBAS.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.char": "Please leave the text legible.",
  "OROBAS.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.next": "Continue",
  "OROBAS.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.ancient": "Then we start in the margins!!!",
  "OROBAS.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.next": "Continue",
  "PAEL.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.ancient": "Friend, your spine is cracked... let me mend it.",
  "PAEL.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.next": "Respond",
  "PAEL.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.char": "Thank you. Please do not seal the pages together.",
  "PAEL.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.next": "Continue",
  "PAEL.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.ancient": "I will be gentle...",
  "PAEL.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.next": "Continue",
  "TANX.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.ancient": "LITTLE BOOK! HAVE YOU RECORDED MY STRENGTH?!",
  "TANX.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.next": "Respond",
  "TANX.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.char": "There is still room in this volume.",
  "TANX.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.next": "Continue",
  "TANX.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.ancient": "THEN GROW STRONGER! FILL IT!!!",
  "TANX.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.next": "Continue",
  "TEZCATARA.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.ancient": "Sweetie, let me burn away those burdensome old pages.",
  "TEZCATARA.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.next": "Respond",
  "TEZCATARA.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.char": "Some scorch marks are records in themselves.",
  "TEZCATARA.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.next": "Continue",
  "TEZCATARA.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.ancient": "Then keep the ones worth remembering.",
  "TEZCATARA.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.next": "Continue",
  "VAKUU.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.ancient": "Keeper of books, what would you trade for power?",
  "VAKUU.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-0r.next": "Respond",
  "VAKUU.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.char": "A loan is possible. Ownership is not for sale.",
  "VAKUU.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-1r.next": "Continue",
  "VAKUU.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.ancient": "Interesting. Then let us discuss the terms.",
  "VAKUU.talk.LIBRARIAN-LIBRARIAN_CHARACTER.0-2r.next": "Continue"
}
